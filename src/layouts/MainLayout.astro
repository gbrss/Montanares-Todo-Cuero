---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Montanares Todo Cuero | Productos y artículos de cuero",
  description = "Artículos de cuero genuino hechos con dedicación y tradición artesanal: billeteras, cinturones, bolsos y accesorios con acabados únicos. Consulta y pedidos directos por WhatsApp."
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="cuero chile, marroquinería artesanal, billeteras de cuero, cinturones cuero genuino, bolsos de cuero, talabartería, Montanares Todo Cuero" />
    <meta name="author" content="Montanares Todo Cuero" />
    <link rel="canonical" href="https://ais-pre-mvybpnz57jqlurroety7jn-260431366643.us-east1.run.app/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ais-pre-mvybpnz57jqlurroety7jn-260431366643.us-east1.run.app/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Montanares Todo Cuero" />
    <meta property="og:locale" content="es_CL" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Montanares Todo Cuero | Artesanía en Cuero Genuino" />
    <meta name="twitter:description" content="Descubre productos con carácter, detalles únicos y esencia artesanal. Atención personalizada por WhatsApp." />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32' fill='%2338271F'%3E%3Cpath d='M16 2C8.268 2 2 8.268 2 16s6.268 14 14 14 14-6.268 14-14S23.732 2 16 2zm0 4c5.523 0 10 4.477 10 10s-4.477 10-10 10S6 21.523 6 16 10.477 6 16 6zm-3.5 6.5a1.5 1.5 0 0 0-1.5 1.5v7a1.5 1.5 0 0 0 3 0V16.5l4 4.5 4-4.5V21a1.5 1.5 0 0 0 3 0v-7a1.5 1.5 0 0 0-2.5-1.125L16 16.375l-4-3.5a1.5 1.5 0 0 0-.5-.375z' fill='%2376513B'/%3E%3C/svg%3E" />

    <!-- Google Fonts: Cormorant Garamond, Playfair Display & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Montanares Todo Cuero",
      "description": "Comercialización y confección artesanal de artículos de cuero genuino en Chile: billeteras, cinturones, bolsos y accesorios con dedicación y estilo duradero.",
      "telephone": "+56927047529",
      "url": "https://ais-pre-mvybpnz57jqlurroety7jn-260431366643.us-east1.run.app/",
      "sameAs": [
        "https://www.facebook.com/profile.php?id=100054494468211",
        "https://wa.me/56927047529"
      ],
      "areaServed": "Chile",
      "priceRange": "$$"
    }
    </script>
  </head>
  <body class="bg-[#F7F2E9] text-[#38271F] font-sans antialiased selection:bg-[#76513B] selection:text-[#F7F2E9] min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
