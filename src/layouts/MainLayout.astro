---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Montanares Todo Cuero | Productos y artículos de cuero",
  description = "Artículos de cuero genuino hechos con dedicación y tradición artesanal: billeteras, cinturones, bolsos y accesorios con acabados únicos. Consulta y pedidos directos por WhatsApp."
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="cuero chile, marroquinería artesanal, billeteras de cuero, cinturones cuero genuino, bolsos de cuero, talabartería, Montanares Todo Cuero" />
    <meta name="author" content="Montanares Todo Cuero" />
    
    <!-- URL Oficial -->
    <link rel="canonical" href="https://montanares-todo-cuero.pages.dev/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://montanares-todo-cuero.pages.dev/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Montanares Todo Cuero" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:image" content="https://montanares-todo-cuero.pages.dev/images/logo.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Montanares Todo Cuero | Artesanía en Cuero Genuino" />
    <meta name="twitter:description" content="Descubre productos con carácter, detalles únicos y esencia artesanal. Atención personalizada por WhatsApp." />
    <meta name="twitter:image" content="https://montanares-todo-cuero.pages.dev/images/logo.png" />

    <!-- Favicon (Usando el logo de la carpeta public) -->
    <link rel="icon" type="image/png" href="/images/logo.png" />

    <!-- Google Fonts: Cormorant Garamond, Playfair Display, Inter & Sancreek -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Sancreek&display=swap" rel="stylesheet" />
    
    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Montanares Todo Cuero",
      "description": "Comercialización y confección artesanal de artículos de cuero genuino en Chile: billeteras, cinturones, bolsos y accesorios con dedicación y estilo duradero.",
      "telephone": "+56927047529",
      "url": "https://montanares-todo-cuero.pages.dev/",
      "image": "https://montanares-todo-cuero.pages.dev/images/logo.png",
      "sameAs": [
        "https://www.facebook.com/profile.php?id=100054494468211",
        "https://wa.me/56927047529"
      ],
      "areaServed": "Chile",
      "priceRange": "$$"
    }
    </script>

    <!-- Script para evitar el parpadeo (Flash) del Modo Oscuro al cargar -->
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-[#F7F2E9] dark:bg-[#1A120D] text-[#38271F] dark:text-[#F7F2E9] font-sans antialiased selection:bg-[#76513B] selection:text-[#F7F2E9] min-h-screen flex flex-col transition-colors duration-300">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>