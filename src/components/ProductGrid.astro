---
import { PRODUCTS, getGeneralWhatsAppUrl } from '../data/products.js';
import ProductCard from './ProductCard.astro';

const CATEGORIES = [
  'Todos',
  'Billeteras & Tarjeteros',
  'Cinturones',
  'Bolsos & Morrales',
  'Accesorios & Taller'
];

const customOrderUrl = getGeneralWhatsAppUrl('Hola Montanares Todo Cuero, me gustaría consultar por un trabajo personalizado o encargo especial en cuero.');
---

<section id="productos" class="py-16 md:py-24 bg-[#F7F2E9] border-t border-[#D9C6A5]/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 md:mb-14">
      <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#76513B] mb-2">
        <span>Catálogo Artesanal</span>
        <span aria-hidden="true">·</span>
        <span>Piezas Únicas</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-[#38271F] [text-wrap:balance]">
        Nuestra Colección de Cuero
      </h2>
      <p class="mt-3 text-sm sm:text-base text-[#38271F]/80 leading-relaxed">
        Cada artículo es elaborado con cueros seleccionados, corte preciso y armado minucioso. Consulta disponibilidad inmediata o encarga tu pieza a medida.
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-10" id="category-filters">
      {CATEGORIES.map((cat, index) => (
        <button
          type="button"
          data-category={cat}
          class={`filter-btn px-4 py-2 rounded-lg text-xs sm:text-sm font-medium transition-all cursor-pointer whitespace-nowrap ${
            index === 0
              ? 'bg-[#38271F] text-[#F7F2E9] shadow-xs active'
              : 'bg-[#D9C6A5]/30 text-[#38271F] hover:bg-[#D9C6A5]/50'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="product-grid">
      {PRODUCTS.map((product) => (
        <div class="product-item" data-category={product.category}>
          <ProductCard product={product} />
        </div>
      ))}
    </div>

    <!-- Custom Order Banner -->
    <div class="mt-14 p-6 sm:p-8 rounded-2xl bg-[#D9C6A5]/25 border border-[#D9C6A5]/60 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center md:text-left">
        <h3 class="font-serif text-lg sm:text-xl font-bold text-[#38271F]">
          ¿Buscas un modelo específico, grabado o medida especial?
        </h3>
        <p class="text-xs sm:text-sm text-[#38271F]/80">
          Confeccionamos pedidos especiales en cuero vacuno y grabados personalizados. Consúltanos directamente por WhatsApp.
        </p>
      </div>

      <a
        href={customOrderUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-3 bg-[#76513B] hover:bg-[#38271F] text-[#F7F2E9] rounded-lg text-xs sm:text-sm font-medium transition-colors shadow-2xs whitespace-nowrap shrink-0 active:scale-95"
      >
        <svg class="w-4 h-4 text-[#D9C6A5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
        </svg>
        <span>Consultar por encargo a medida</span>
      </a>
    </div>

  </div>

  <!-- Accessible Product Details Modal -->
  <div 
    id="product-modal" 
    class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 sm:p-6 bg-[#38271F]/80 backdrop-blur-xs"
    role="dialog"
    aria-modal="true"
  >
    <div class="relative bg-[#F7F2E9] rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl border border-[#D9C6A5]/50 p-6 sm:p-8">
      <button
        type="button"
        id="modal-close-btn"
        class="absolute top-4 right-4 p-2 rounded-full text-[#38271F]/70 hover:text-[#38271F] hover:bg-[#D9C6A5]/30 transition-colors z-10"
        aria-label="Cerrar modal"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
        <div class="rounded-xl overflow-hidden border border-[#D9C6A5]/60 bg-white group cursor-zoom-in relative">
          
          <!-- IMAGEN CON EFECTO DE ZOOM Y MOVIMIENTO -->
          <img
            id="modal-image"
            src=""
            alt=""
            class="w-full h-full aspect-4/3 object-cover transition-transform duration-700 ease-out group-hover:scale-125"
            referrerpolicy="no-referrer"
            title="Haz clic para ampliar"
          />

        </div>

        <div class="space-y-4">
          <div>
            <span id="modal-category" class="text-xs font-semibold uppercase tracking-wider text-[#76513B]"></span>
            <h2 id="modal-title" class="font-serif text-2xl font-bold text-[#38271F] mt-1"></h2>
          </div>

          <p id="modal-description" class="text-sm text-[#38271F]/80 leading-relaxed"></p>

          <div class="space-y-2 pt-2 border-t border-[#D9C6A5]/40 text-xs">
            <div class="text-[#38271F]">
              <strong>Material:</strong> <span id="modal-material"></span>
            </div>
            <div id="modal-dimensions-container" class="text-[#38271F]">
              <strong>Dimensiones:</strong> <span id="modal-dimensions"></span>
            </div>
          </div>

          <div class="pt-2">
            <h3 class="text-xs font-semibold text-[#38271F] uppercase tracking-wider mb-2">
              Detalles de confección:
            </h3>
            <ul id="modal-features" class="space-y-1.5 text-xs text-[#38271F]/85"></ul>
          </div>

          <div class="bg-[#D9C6A5]/20 p-3 rounded-lg border border-[#D9C6A5]/50 text-xs space-y-1">
            <p class="font-semibold text-[#38271F]">Cuidado del cuero genuino:</p>
            <p class="text-[#38271F]/80">
              Evitar calor directo y exceso de agua. Aplicar bálsamo neutro periódicamente para mantener la elasticidad y pátina.
            </p>
          </div>

          <div class="pt-2">
            <a
              id="modal-whatsapp-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-center gap-2 px-5 py-3 bg-[#38271F] hover:bg-[#76513B] text-[#F7F2E9] rounded-lg text-sm font-medium transition-all shadow-xs hover:shadow-md active:scale-95 whitespace-nowrap"
            >
              <svg class="w-4 h-4 text-[#D9C6A5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
              </svg>
              <span>Consultar disponibilidad en WhatsApp</span>
            </a>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<!-- Client Script for Filtering & Modal -->
<script define:vars={{ products: PRODUCTS }}>
  // Category Filtering
  const filterButtons = document.querySelectorAll('.filter-btn');
  const productItems = document.querySelectorAll('.product-item');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => {
        b.classList.remove('bg-[#38271F]', 'text-[#F7F2E9]', 'shadow-xs', 'active');
        b.classList.add('bg-[#D9C6A5]/30', 'text-[#38271F]');
      });
      btn.classList.add('bg-[#38271F]', 'text-[#F7F2E9]', 'shadow-xs', 'active');
      btn.classList.remove('bg-[#D9C6A5]/30', 'text-[#38271F]');

      const selected = btn.getAttribute('data-category');
      productItems.forEach((item) => {
        if (selected === 'Todos' || item.getAttribute('data-category') === selected) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });

  // Modal Handling
  const modal = document.getElementById('product-modal');
  const closeBtn = document.getElementById('modal-close-btn');
  const modalImg = document.getElementById('modal-image');
  const modalCategory = document.getElementById('modal-category');
  const modalTitle = document.getElementById('modal-title');
  const modalDesc = document.getElementById('modal-description');
  const modalMaterial = document.getElementById('modal-material');
  const modalDim = document.getElementById('modal-dimensions');
  const modalFeatures = document.getElementById('modal-features');
  const modalWhatsApp = document.getElementById('modal-whatsapp-link');

  function openProductModal(productId) {
    const product = products.find((p) => p.id === productId);
    if (!product || !modal) return;

    modalImg.src = product.image.src;
    modalImg.alt = product.name;
    modalCategory.textContent = product.category;
    modalTitle.textContent = product.name;
    modalDesc.textContent = product.description;
    modalMaterial.textContent = product.material;
    modalDim.textContent = product.dimensions || 'Estándar';

    // FUNCIÓN DE ZOOM: Al hacer clic en la imagen, se abre en tamaño original
    modalImg.onclick = () => {
      window.open(product.image.src, '_blank');
    };

    modalFeatures.innerHTML = '';
    product.features.forEach((feat) => {
      const li = document.createElement('li');
      li.className = 'flex items-center gap-2';
      li.innerHTML = `
        <svg class="w-3.5 h-3.5 text-[#76513B] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>${feat}</span>
      `;
      modalFeatures.appendChild(li);
    });

    const msg = `Hola Montanares Todo Cuero, me gustaría consultar por la disponibilidad de: ${product.name}. ¿Me podrían dar más detalles sobre disponibilidad y envíos?`;
    modalWhatsApp.href = `https://wa.me/56927047529?text=${encodeURIComponent(msg)}`;

    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeProductModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    document.body.style.overflow = 'unset';
  }

  document.querySelectorAll('.product-card-trigger').forEach((el) => {
    el.addEventListener('click', () => {
      const id = el.getAttribute('data-product-id');
      if (id) openProductModal(id);
    });
  });

  closeBtn?.addEventListener('click', closeProductModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeProductModal();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeProductModal();
  });
</script>