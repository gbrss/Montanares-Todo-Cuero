---
import { WHATSAPP_DISPLAY, getGeneralWhatsAppUrl } from '../data/products.js';

const whatsappUrl = getGeneralWhatsAppUrl();
---

<div class="fixed bottom-5 right-5 z-40 flex flex-col items-end gap-2" id="whatsapp-floating-container">
  <!-- Friendly Prompt -->
  <div id="whatsapp-tooltip" class="hidden sm:flex items-center gap-2 bg-[#38271F] text-[#F7F2E9] text-xs py-2 px-3.5 rounded-xl shadow-lg border border-[#D9C6A5]/40 animate-in fade-in slide-in-from-bottom-2 duration-300">
    <span>¿Dudas sobre algún producto?</span>
    <button
      type="button"
      id="whatsapp-tooltip-close"
      class="text-[#D9C6A5] hover:text-white p-0.5 rounded-full cursor-pointer"
      aria-label="Cerrar sugerencia"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Floating Button -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="w-14 h-14 rounded-full bg-[#25D366] hover:bg-[#20ba5a] text-white flex items-center justify-center shadow-xl hover:scale-105 active:scale-95 transition-all duration-200 focus:outline-hidden focus:ring-4 focus:ring-[#25D366]/40"
    aria-label={`Contactar por WhatsApp a ${WHATSAPP_DISPLAY}`}
    title={`Consultar por WhatsApp (${WHATSAPP_DISPLAY})`}
  >
    <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.974.55 1.777.848 2.796.849 3.18 0 5.767-2.586 5.768-5.766.001-3.18-2.585-5.636-5.768-5.636zm3.385 8.169c-.144.405-.837.774-1.17.823-.312.045-.698.073-2.023-.473-1.603-.661-2.617-2.28-2.697-2.387-.08-.107-.648-.863-.648-1.646 0-.783.411-1.168.558-1.328.147-.16.321-.2.428-.2.107 0 .214.001.307.006.099.005.231-.038.361.275.134.321.455 1.11.495 1.191.04.081.067.175.013.282-.053.107-.08.174-.16.267-.08.094-.17.21-.242.282-.08.08-.163.167-.07.327.093.16.414.683.889 1.106.611.544 1.127.712 1.287.792.16.08.254.067.348-.04.093-.108.401-.468.508-.629.107-.16.214-.134.361-.08.147.054.935.441 1.096.521.16.08.267.12.307.187.04.067.04.388-.104.793zM12 2C6.477 2 2 6.477 2 12c0 1.891.523 3.66 1.433 5.174L2 22l4.954-1.399A9.956 9.956 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"></path>
    </svg>
  </a>
</div>

<script>
  const tooltip = document.getElementById('whatsapp-tooltip');
  const closeBtn = document.getElementById('whatsapp-tooltip-close');
  closeBtn?.addEventListener('click', () => {
    tooltip?.classList.add('hidden');
  });
</script>
