---
import { WHATSAPP_DISPLAY, getGeneralWhatsAppUrl } from '../data/products.js';

const whatsappUrl = getGeneralWhatsAppUrl();
---

<style>
  @keyframes pulse-ring {
    0% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 15px rgba(37, 211, 102, 0); }
    100% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
  }
  .animate-pulse-ring {
    animation: pulse-ring 2s infinite;
  }
</style>

<div class="fixed bottom-5 right-5 z-50 flex flex-col items-end gap-2 pointer-events-none" id="whatsapp-floating-container">
  <!-- Tooltip: pointer-events-none para que no tape los clics del fondo -->
  <div id="whatsapp-tooltip" class="pointer-events-auto flex items-center gap-2 bg-[#38271F] text-[#F7F2E9] text-xs py-2 px-3.5 rounded-xl shadow-lg border border-[#D9C6A5]/40 transition-opacity duration-300">
    <span>¿Dudas sobre algún producto?</span>
    <button
      type="button"
      id="whatsapp-tooltip-close"
      class="text-[#D9C6A5] hover:text-white p-1 rounded-full cursor-pointer focus:outline-none"
      aria-label="Cerrar sugerencia"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Botón flotante: pointer-events-auto para que sea clickeable -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="pointer-events-auto w-14 h-14 rounded-full bg-[#25D366] hover:bg-[#20ba5a] text-white flex items-center justify-center shadow-xl hover:scale-105 active:scale-95 transition-all duration-200 focus:outline-hidden focus:ring-4 focus:ring-[#25D366]/40 animate-pulse-ring"
    aria-label={`Contactar por WhatsApp a ${WHATSAPP_DISPLAY}`}
    title={`Consultar por WhatsApp (${WHATSAPP_DISPLAY})`}
  >
    <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
    </svg>
  </a>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tooltip = document.getElementById('whatsapp-tooltip');
    const closeBtn = document.getElementById('whatsapp-tooltip-close');
    if (closeBtn && tooltip) {
      closeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        tooltip.style.display = 'none';
      });
    }
  });
</script>