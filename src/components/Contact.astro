---
import { WHATSAPP_DISPLAY, WHATSAPP_NUMBER, FACEBOOK_URL, PRODUCTS, getGeneralWhatsAppUrl } from '../data/products.js';

const generalWhatsAppUrl = getGeneralWhatsAppUrl();
---

<section id="contacto" class="py-16 md:py-24 bg-[#F7F2E9] dark:bg-[#1A120D] border-t border-[#D9C6A5]/40 dark:border-[#5C3A21]/50 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Official Contact Info -->
      <div class="lg:col-span-5 space-y-8">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#76513B] dark:text-[#D9C6A5] transition-colors">
            <span>Atención Personalizada</span>
            <span aria-hidden="true">·</span>
            <span>Canales Oficiales</span>
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#38271F] dark:text-[#F7F2E9] [text-wrap:balance] transition-colors">
            ¿Te gustó algún producto?
          </h2>
          <p class="text-base text-[#38271F]/80 dark:text-[#F7F2E9]/80 leading-relaxed transition-colors">
            Escríbenos y consulta por nuestros productos, disponibilidad y pedidos. ¡Será un gusto atenderte!
          </p>
        </div>

        <div class="space-y-4">
          <!-- WhatsApp Card -->
          <a
            href={generalWhatsAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start gap-4 p-5 rounded-xl bg-white dark:bg-[#251A14] border border-[#D9C6A5]/60 dark:border-[#5C3A21]/50 hover:border-[#76513B] dark:hover:border-[#D9C6A5] shadow-2xs hover:shadow-md dark:shadow-lg transition-all duration-300"
          >
            <div class="w-12 h-12 rounded-lg bg-[#38271F] dark:bg-[#76513B] group-hover:bg-[#76513B] text-[#D9C6A5] flex items-center justify-center shrink-0 transition-colors">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
              </svg>
            </div>
            <div class="space-y-1">
              <span class="text-xs font-medium text-[#76513B] dark:text-[#D9C6A5] uppercase tracking-wide transition-colors">
                Canal Principal WhatsApp
              </span>
              <h3 class="font-serif text-lg font-bold text-[#38271F] dark:text-[#F7F2E9] group-hover:text-[#76513B] dark:group-hover:text-[#D9C6A5] transition-colors">
                {WHATSAPP_DISPLAY}
              </h3>
              <p class="text-xs text-[#38271F]/70 dark:text-[#F7F2E9]/70 transition-colors">
                Atención rápida, fotos adicionales y coordinación de pedidos.
              </p>
            </div>
          </a>

          <!-- Facebook Card -->
          <a
            href={FACEBOOK_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start gap-4 p-5 rounded-xl bg-white dark:bg-[#251A14] border border-[#D9C6A5]/60 dark:border-[#5C3A21]/50 hover:border-[#76513B] dark:hover:border-[#D9C6A5] shadow-2xs hover:shadow-md dark:shadow-lg transition-all duration-300"
          >
            <div class="w-12 h-12 rounded-lg bg-[#38271F] dark:bg-[#76513B] group-hover:bg-[#76513B] text-[#D9C6A5] flex items-center justify-center shrink-0 transition-colors">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </div>
            <div class="space-y-1">
              <span class="text-xs font-medium text-[#76513B] dark:text-[#D9C6A5] uppercase tracking-wide transition-colors">
                Página Oficial en Facebook
              </span>
              <h3 class="font-serif text-lg font-bold text-[#38271F] dark:text-[#F7F2E9] group-hover:text-[#76513B] dark:group-hover:text-[#D9C6A5] transition-colors">
                Montanares Todo Cuero
              </h3>
              <p class="text-xs text-[#38271F]/70 dark:text-[#F7F2E9]/70 transition-colors">
                Sigue nuestras publicaciones, novedades y nuevos trabajos de taller.
              </p>
            </div>
          </a>

          <!-- Shipping Card -->
          <div class="flex items-start gap-4 p-5 rounded-xl bg-[#D9C6A5]/20 dark:bg-[#38271F]/40 border border-[#D9C6A5]/50 dark:border-[#5C3A21]/50 transition-colors duration-300">
            <div class="w-12 h-12 rounded-lg bg-[#76513B]/20 dark:bg-[#76513B]/40 text-[#38271F] dark:text-[#D9C6A5] flex items-center justify-center shrink-0 transition-colors">
              <svg class="w-6 h-6 text-[#76513B] dark:text-[#D9C6A5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
            </div>
            <div class="space-y-1">
              <h3 class="font-serif text-base font-bold text-[#38271F] dark:text-[#F7F2E9] transition-colors">
                Despachos a Regiones
              </h3>
              <p class="text-xs text-[#38271F]/80 dark:text-[#F7F2E9]/80 leading-relaxed transition-colors">
                Realizamos envíos coordinados a lo largo de todo Chile. Embalaje protegido para asegurar que tus artículos de cuero lleguen en perfectas condiciones.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Consultation Form -->
      <div class="lg:col-span-7">
        <div class="bg-white dark:bg-[#251A14] p-6 sm:p-8 rounded-2xl border border-[#D9C6A5]/60 dark:border-[#5C3A21]/50 shadow-md transition-colors duration-300">
          <div class="space-y-1">
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#38271F] dark:text-[#F7F2E9] transition-colors">
              Consulta rápida y directa
            </h3>
            <p class="text-xs sm:text-sm text-[#38271F]/75 dark:text-[#F7F2E9]/75 transition-colors">
              Completa estos datos para abrir WhatsApp con tu consulta armada y lista para enviar.
            </p>
          </div>

          <form id="contact-form" class="space-y-4 mt-6">
            <div>
              <label for="contact-name" class="block text-xs font-medium text-[#38271F] dark:text-[#F7F2E9] mb-1 transition-colors">
                Tu nombre (opcional):
              </label>
              <input
                id="contact-name"
                type="text"
                placeholder="Ej. Juan Pérez"
                class="w-full px-3.5 py-2.5 rounded-lg border border-[#D9C6A5] dark:border-[#5C3A21] bg-[#F7F2E9]/40 dark:bg-[#1A120D] text-sm text-[#38271F] dark:text-[#F7F2E9] placeholder-[#38271F]/40 dark:placeholder-[#F7F2E9]/40 focus:outline-hidden focus:ring-2 focus:ring-[#76513B] dark:focus:ring-[#D9C6A5] transition-colors"
              />
            </div>

            <div>
              <label for="contact-product" class="block text-xs font-medium text-[#38271F] dark:text-[#F7F2E9] mb-1 transition-colors">
                Producto de interés:
              </label>
              <select
                id="contact-product"
                class="w-full px-3.5 py-2.5 rounded-lg border border-[#D9C6A5] dark:border-[#5C3A21] bg-[#F7F2E9]/40 dark:bg-[#1A120D] text-sm text-[#38271F] dark:text-[#F7F2E9] focus:outline-hidden focus:ring-2 focus:ring-[#76513B] dark:focus:ring-[#D9C6A5] transition-colors"
              >
                <option value="">-- Consulta general de catálogo --</option>
                {PRODUCTS.map((prod) => (
                  <option value={prod.name}>
                    {prod.name} ({prod.category})
                  </option>
                ))}
                <option value="Trabajo personalizado / Medida especial">
                  Trabajo personalizado / Medida especial
                </option>
              </select>
            </div>

            <div>
              <label for="contact-query" class="block text-xs font-medium text-[#38271F] dark:text-[#F7F2E9] mb-1 transition-colors">
                Mensaje o duda:
              </label>
              <textarea
                id="contact-query"
                rows="3"
                placeholder="Escribe aquí tu consulta, color de cuero preferido, medidas o ciudad de despacho..."
                class="w-full px-3.5 py-2.5 rounded-lg border border-[#D9C6A5] dark:border-[#5C3A21] bg-[#F7F2E9]/40 dark:bg-[#1A120D] text-sm text-[#38271F] dark:text-[#F7F2E9] placeholder-[#38271F]/40 dark:placeholder-[#F7F2E9]/40 focus:outline-hidden focus:ring-2 focus:ring-[#76513B] dark:focus:ring-[#D9C6A5] transition-colors"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full flex items-center justify-center gap-2 px-6 py-3.5 bg-[#38271F] dark:bg-[#76513B] hover:bg-[#76513B] dark:hover:bg-[#5C3A21] text-[#F7F2E9] rounded-lg text-sm font-semibold tracking-wide transition-all shadow-sm hover:shadow-md active:scale-98 cursor-pointer"
            >
              <svg class="w-5 h-5 text-[#D9C6A5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
              </svg>
              <span>Hablar por WhatsApp (+56 9 2704 7529)</span>
            </button>

            <p class="text-[11px] text-center text-[#38271F]/60 dark:text-[#F7F2E9]/60 transition-colors">
              Se abrirá tu aplicación de WhatsApp con el mensaje listo para enviar.
            </p>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  const nameInput = document.getElementById('contact-name');
  const prodInput = document.getElementById('contact-product');
  const queryInput = document.getElementById('contact-query');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    let text = 'Hola Montanares Todo Cuero';
    const name = nameInput?.value?.trim();
    const prod = prodInput?.value?.trim();
    const query = queryInput?.value?.trim();

    if (name) text += `, mi nombre es ${name}`;
    if (prod) text += `. Me gustaría consultar disponibilidad del producto: ${prod}`;
    if (query) text += `. ${query}`;
    else if (!prod) text += '. Me gustaría consultar por sus productos y opciones de envío.';

    const url = `https://wa.me/56927047529?text=${encodeURIComponent(text)}`;
    window.open(url, '_blank', 'noopener,noreferrer');
  });
</script>